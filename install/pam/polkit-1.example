#%PAM-1.0

# Local fingerprint authentication; password remains available.
auth requisite pam_faillock.so preauth
# Scan first; after 15 seconds offer the normal password prompt.
auth [success=1 default=ignore] pam_fprintd.so max-tries=3 timeout=15
auth substack system-auth
auth required pam_env.so
auth required pam_faillock.so authsucc
# End local fingerprint authentication.
account    include      system-auth
password   include      system-auth
session    include      system-auth
